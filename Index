function initFilters() {
  const confrarias = [...new Set(DATA.map(d => d.confrariaNome).filter(Boolean))].sort();
  const categorias = [...new Set(DATA.map(d => d.categoria).filter(Boolean))].sort();
  const familias = [...new Set(DATA.map(d => d.familia).filter(Boolean))].sort();
  const estilos = [...new Set(DATA.map(d => d.estilo).filter(Boolean))].sort();

  populateSelect(selConf, confrarias, "Todas as Confrarias");
  populateSelect(selCat, categorias, "Todas as Categorias");
  populateSelect(selFam, familias, "Todas as Famílias");
  populateSelect(selEstilo, estilos, "Todos os Estilos");
}

function populateSelect(selectEl, items, defaultText) {
  if (!selectEl) return;
  selectEl.innerHTML = `<option value="">${defaultText}</option>`;
  items.forEach(item => {
    const opt = document.createElement('option');
    opt.value = item;
    opt.textContent = item;
    selectEl.appendChild(opt);
  });
}

function parseNum(val) {
  if (!val) return -1;
  const cleaned = val.toString().replace('%', '').replace(',', '.').trim();
  const num = parseFloat(cleaned);
  return isNaN(num) ? -1 : num;
}

window.filterData = function() {
  const q = (searchInput ? searchInput.value : '').toLowerCase().trim();
  const confVal = selConf ? selConf.value : '';
  const catVal = selCat ? selCat.value : '';
  const famVal = selFam ? selFam.value : '';
  const estiloVal = selEstilo ? selEstilo.value : '';
  const sortVal = selSort ? selSort.value : '';

  let filtered = DATA.map((item, index) => ({ item, index })).filter(({ item, index }) => {
    if (activeQuickFilter === 'fav' && !window.favorites.includes(index)) return false;
    if (activeQuickFilter === 'rio' && item.categoria !== 'Estilo Rio') return false;
    if (activeQuickFilter === 'bitter' && !item.estilo.toLowerCase().includes('bitter')) return false;
    if (activeQuickFilter === 'ipa' && item.familia !== 'IPA & Lupuladas') return false;
    if (activeQuickFilter === 'zero' && parseNum(item.abv) > 0.5) return false;

    if (confVal && item.confrariaNome !== confVal) return false;
    if (catVal && item.categoria !== catVal) return false;
    if (famVal && item.familia !== famVal) return false;
    if (estiloVal && item.estilo !== estiloVal) return false;

    if (q) {
      const matchText = `${item.cerveja} ${item.estilo} ${item.confrariaNome} ${item.responsavel} ${item.descricao} ${item.categoria}`.toLowerCase();
      if (!matchText.includes(q)) return false;
    }
    return true;
  });

  if (sortVal === 'abv_desc') {
    filtered.sort((a, b) => parseNum(b.item.abv) - parseNum(a.item.abv));
  } else if (sortVal === 'abv_asc') {
    filtered.sort((a, b) => {
      const numA = parseNum(a.item.abv);
      const numB = parseNum(b.item.abv);
      if (numA < 0) return 1;
      if (numB < 0) return -1;
      return numA - numB;
    });
  } else if (sortVal === 'ibu_desc') {
    filtered.sort((a, b) => parseNum(b.item.ibu) - parseNum(a.item.ibu));
  } else if (sortVal === 'ibu_asc') {
    filtered.sort((a, b) => {
      const numA = parseNum(a.item.ibu);
      const numB = parseNum(b.item.ibu);
      if (numA < 0) return 1;
      if (numB < 0) return -1;
      return numA - numB;
    });
  }

  renderGrid(filtered);
  updateStats(filtered);
};

function renderGrid(filteredItems) {
  if (!grid) return;
  grid.innerHTML = '';

  const resultCount = document.getElementById('resultCount');
  if (resultCount) {
    resultCount.textContent = `Exibindo ${filteredItems.length} de ${DATA.length} cervejas`;
  }

  if (filteredItems.length === 0) {
    grid.innerHTML = `<div class="empty">Nenhuma cerveja encontrada com os filtros selecionados.</div>`;
    return;
  }

  filteredItems.forEach(({ item, index }) => {
    const card = createCard(item, index);
    grid.appendChild(card);
  });
}

function createCard(item, index) {
  const isFav = window.favorites.includes(index);
  const card = document.createElement('div');
  card.className = 'card';
  card.dataset.index = index;

  card.innerHTML = `
    <div class="stripe" style="--c: ${getFamilyColor(item.familia)}"></div>
    <button class="fav" aria-pressed="${isFav}" title="Favoritar">⭐</button>
    <div class="body">
      <span class="tag" style="--c: ${getFamilyColor(item.familia)}">${item.categoria}</span>
      <h3>${item.cerveja}</h3>
      <div class="meta">
        ${item.estilo} <br>
        <strong>ABV:</strong> ${item.abv || 'N/I'} | 
        <strong>IBU:</strong> ${item.ibu || 'N/I'} | 
        <strong>EBC:</strong> ${item.ebc || 'N/I'}
      </div>
      <p class="desc">${item.descricao || 'Sem descrição cadastrada.'}</p>
      <div class="owner"><strong>Responsável:</strong> ${item.responsavel} (${item.confraria})</div>
    </div>
  `;

  card.querySelector('.fav').addEventListener('click', (e) => {
    e.stopPropagation();
    toggleFav(index);
  });

  card.addEventListener('click', () => openModal(item, index));
  return card;
}

function openModal(item, index) {
  currentModalIndex = index;
  const mn = document.getElementById('mn');
  const mdesc = document.getElementById('mdesc');
  if (mn) mn.textContent = item.cerveja;
  if (mdesc) mdesc.textContent = item.descricao || 'Sem descrição cadastrada.';

  const detailsContainer = document.querySelector('.modal .details');
  if (detailsContainer) {
    detailsContainer.innerHTML = `
      <div class="detail"><b>Confraria</b> ${item.confrariaNome}</div>
      <div class="detail"><b>Categoria</b> ${item.categoria}</div>
      <div class="detail"><b>Estilo</b> ${item.estilo}</div>
      <div class="detail"><b>Família</b> ${item.familia}</div>
      <div class="detail"><b>ABV</b> ${item.abv || 'Não informado'}</div>
      <div class="detail"><b>IBU</b> ${item.ibu || 'Não informado'}</div>
      <div class="detail"><b>EBC</b> ${item.ebc || 'Não informado'}</div>
      <div class="detail"><b>Responsável</b> ${item.responsavel}</div>
    `;
  }

  renderStars(window.ratings[index] || 0);

  if (noteTextarea) {
    noteTextarea.value = window.notes[index] || '';
  }

  if (modal) modal.classList.add('open');
}

function closeModal() {
  if (modal) modal.classList.remove('open');
  currentModalIndex = null;
}

function toggleFav(index) {
  const i = window.favorites.indexOf(index);
  if (i > -1) {
    window.favorites.splice(i, 1);
    showToast('Removido dos favoritos');
  } else {
    window.favorites.push(index);
    showToast('Adicionado aos favoritos! ⭐');
  }
  
  if (window.syncPreferencesToCloud) {
    window.syncPreferencesToCloud();
  } else {
    localStorage.setItem('fdcrj_favs', JSON.stringify(window.favorites));
  }
  window.filterData();
}

function renderStars(rating) {
  if (!starsContainer) return;
  starsContainer.innerHTML = '';
  for (let i = 1; i <= 5; i++) {
    const btn = document.createElement('button');
    btn.className = `star ${i <= rating ? 'on' : ''}`;
    btn.textContent = '★';
    btn.type = 'button';
    btn.addEventListener('click', () => setRating(i));
    starsContainer.appendChild(btn);
  }
}

function setRating(r) {
  if (currentModalIndex === null) return;
  window.ratings[currentModalIndex] = r;
  
  if (window.syncPreferencesToCloud) {
    window.syncPreferencesToCloud();
  } else {
    localStorage.setItem('fdcrj_ratings', JSON.stringify(window.ratings));
  }
  
  renderStars(r);
  showToast(`Avaliado com ${r} estrela(s)!`);
}

if (noteTextarea) {
  noteTextarea.addEventListener('input', () => {
    if (currentModalIndex === null) return;
    window.notes[currentModalIndex] = noteTextarea.value;
    
    if (window.syncPreferencesToCloud) {
      window.syncPreferencesToCloud();
    } else {
      localStorage.setItem('fdcrj_notes', JSON.stringify(window.notes));
    }
  });
}

function updateStats(filtered) {
  const sBeers = document.getElementById('sBeers');
  const sConf = document.getElementById('sConf');
  const sStyles = document.getElementById('sStyles');
  const sFav = document.getElementById('sFav');

  if (sBeers) sBeers.textContent = filtered.length;
  if (sConf) sConf.textContent = new Set(filtered.map(f => f.item.confrariaNome)).size;
  if (sStyles) sStyles.textContent = new Set(filtered.map(f => f.item.estilo)).size;
  if (sFav) sFav.textContent = window.favorites.length;
}

window.showToast = function(msg) {
  let toast = document.querySelector('.toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.className = 'toast';
    document.body.appendChild(toast);
  }
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2500);
};

document.addEventListener('DOMContentLoaded', () => {
  initFilters();
  window.filterData();

  if (searchInput) searchInput.addEventListener('input', window.filterData);
  if (selConf) selConf.addEventListener('change', window.filterData);
  if (selCat) selCat.addEventListener('change', window.filterData);
  if (selFam) selFam.addEventListener('change', window.filterData);
  if (selEstilo) selEstilo.addEventListener('change', window.filterData);
  if (selSort) selSort.addEventListener('change', window.filterData);

  const btnClear = document.getElementById('btnClear');
  if (btnClear) {
    btnClear.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (selConf) selConf.value = '';
      if (selCat) selCat.value = '';
      if (selFam) selFam.value = '';
      if (selEstilo) selEstilo.value = '';
      if (selSort) selSort.value = '';
      activeQuickFilter = null;
      document.querySelectorAll('.pill').forEach(p => p.setAttribute('aria-pressed', 'false'));
      window.filterData();
    });
  }

  document.querySelectorAll('.pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const type = pill.dataset.filter;
      if (activeQuickFilter === type) {
        activeQuickFilter = null;
        pill.setAttribute('aria-pressed', 'false');
      } else {
        document.querySelectorAll('.pill').forEach(p => p.setAttribute('aria-pressed', 'false'));
        activeQuickFilter = type;
        pill.setAttribute('aria-pressed', 'true');
      }
      window.filterData();
    });
  });

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
});
</script>

<!-- Módulo Firebase v10 para Login Google e Sincronização em Nuvem -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
  import { getFirestore, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

  // Cole aqui suas credenciais do Firebase Console
  const firebaseConfig = {
    apiKey: "SUA_API_KEY_AQUI",
    authDomain: "seu-projeto.firebaseapp.com",
    projectId: "seu-projeto-id",
    storageBucket: "seu-projeto.appspot.com",
    messagingSenderId: "123456789",
    appId: "1:123456789:web:abcdef"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);
  const provider = new GoogleAuthProvider();

  const authBtn = document.getElementById('googleAuthBtn');
  const userInfo = document.getElementById('userInfo');
  let currentUser = null;

  // Função Global de Sincronização com o Firestore
  window.syncPreferencesToCloud = async function() {
    localStorage.setItem('fdcrj_favs', JSON.stringify(window.favorites || []));
    localStorage.setItem('fdcrj_ratings', JSON.stringify(window.ratings || {}));
    localStorage.setItem('fdcrj_notes', JSON.stringify(window.notes || {}));

    if (currentUser) {
      try {
        await setDoc(doc(db, "users", currentUser.uid), {
          favorites: window.favorites || [],
          ratings: window.ratings || {},
          notes: window.notes || {},
          updatedAt: new Date().toISOString()
        }, { merge: true });
      } catch (err) {
        console.error("Erro ao sincronizar com Firebase:", err);
      }
    }
  };

  async function loadUserPreferences(user) {
    try {
      const userRef = doc(db, "users", user.uid);
      const docSnap = await getDoc(userRef);

      if (docSnap.exists()) {
        const data = docSnap.data();
        if (data.favorites) window.favorites = data.favorites;
        if (data.ratings) window.ratings = data.ratings;
        if (data.notes) window.notes = data.notes;

        localStorage.setItem('fdcrj_favs', JSON.stringify(window.favorites));
        localStorage.setItem('fdcrj_ratings', JSON.stringify(window.ratings));
        localStorage.setItem('fdcrj_notes', JSON.stringify(window.notes));

        if (typeof window.filterData === 'function') window.filterData();
        if (typeof window.showToast === 'function') window.showToast("Dados sincronizados da nuvem! ☁️");
      } else {
        // Se é o primeiro login, sobe o que estava no localStorage
        window.syncPreferencesToCloud();
      }
    } catch (err) {
      console.error("Erro ao carregar dados do usuário:", err);
    }
  }

  onAuthStateChanged(auth, (user) => {
    currentUser = user;
    if (user) {
      if (authBtn) authBtn.innerHTML = "🚪 Sair";
      if (userInfo) {
        userInfo.style.display = "block";
        userInfo.innerHTML = `Conectado como: <strong>${user.displayName || user.email}</strong>`;
      }
      loadUserPreferences(user);
    } else {
      if (authBtn) authBtn.innerHTML = "🔑 Entrar com Google";
      if (userInfo) userInfo.style.display = "none";
    }
  });

  if (authBtn) {
    authBtn.addEventListener('click', async () => {
      if (currentUser) {
        await signOut(auth);
        if (typeof window.showToast === 'function') window.showToast("Sessão encerrada");
      } else {
        try {
          await signInWithPopup(auth, provider);
        } catch (err) {
          console.error("Erro ao autenticar com o Google:", err);
        }
      }
    });
  }
</script>

