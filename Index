function setTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  localStorage.setItem('fdcrj_theme', theme);
  if (themeToggleBtn) {
    themeToggleBtn.innerHTML = theme === 'dark' ? '🌙 Modo Escuro' : '☀️ Modo Claro';
  }
}

const savedTheme = localStorage.getItem('fdcrj_theme') || 'dark';
